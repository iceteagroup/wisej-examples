<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Antlr" Version="3.4.1.9004" />
    <PackageVersion Include="bootstrap" Version="3.0.0" />
    <PackageVersion Include="EntityFramework" Version="6.1.3" />
    <PackageVersion Include="jQuery" Version="1.10.2" />
    <PackageVersion Include="jQuery.Validation" Version="1.11.1" />
    <PackageVersion Include="Microsoft.AspNet.Identity.Core" Version="2.2.1" />
    <PackageVersion Include="Microsoft.AspNet.Identity.EntityFramework" Version="2.2.1" />
    <PackageVersion Include="Microsoft.AspNet.Identity.Owin" Version="2.2.1" />
    <PackageVersion Include="Microsoft.AspNet.Mvc" Version="5.2.3" />
    <PackageVersion Include="Microsoft.AspNet.Razor" Version="3.2.3" />
    <PackageVersion Include="Microsoft.AspNet.Web.Optimization" Version="1.1.3" />
    <PackageVersion Include="Microsoft.AspNet.WebPages" Version="3.2.3" />
    <PackageVersion Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" Version="1.0.0" />
    <PackageVersion Include="Microsoft.jQuery.Unobtrusive.Validation" Version="3.2.3" />
    <PackageVersion Include="Microsoft.Net.Compilers" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Owin" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Owin.Host.SystemWeb" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Owin.Security" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Owin.Security.Cookies" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Owin.Security.Facebook" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Owin.Security.Google" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Owin.Security.MicrosoftAccount" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Owin.Security.OAuth" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Owin.Security.Twitter" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Web.Infrastructure" Version="1.0.0.0" />
    <PackageVersion Include="Modernizr" Version="2.6.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="6.0.4" />
    <PackageVersion Include="Owin" Version="1.0" />
    <PackageVersion Include="Respond" Version="1.2.0" />
	<PackageVersion Include="WebGrease" Version="1.5.2" />
	<PackageVersion Include="Wisej-3" Version="3.5.16" />
	<PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
	<PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>
</Project>